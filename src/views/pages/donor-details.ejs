<!DOCTYPE html>
<html lang="en">
<%- include('../partials/head'); %>
    <title>
        <%= page && page.title ? page.title : 'Donor Profile | Blood Bank Management System' %>
    </title>

    <body>
        <main class="d-flex min-vh-100" style="background-color: #f5f5f5;">
            <%- include('../partials/sidebar'); %>

                <div class="hp-main-layout">
                    <%- include('../partials/top-navigation'); %>

                        <div class="hp-main-layout-content">
                            <div class="row mb-32">
                                <div class="col-12 col-lg-10">
                                    <h1 class="mb-8">Donor Profile</h1>
                                    <%- include('../partials/breadcrumb', { breadcrumbs: breadcrumbs }) %>
                                </div>
                            </div>

                            <% const donorData=typeof donor !=='undefined' ? donor : {}; %>
                                <% const donorId=donorData.id || donorData.id || donorData._id || '' ; %>
                                    <% const donationId=donorData.donationId || donorData.id || donorData._id || '' ; %>
                                        <% const donorName=donorData.name || 'Unnamed Donor' ; %>
                                            <% const donorImage=donorData.image || '/img/logo.png' ; %>
                                                <% const dateOfBirth=donorData.dateOfBirth ? new
                                                    Date(donorData.dateOfBirth).toLocaleDateString() : 'Not provided' ;
                                                    %>
                                                    <% const lastDonated=donorData.lastDonated ? new
                                                        Date(donorData.lastDonated).toLocaleDateString()
                                                        : 'Never donated' ; %>
                                                        <% const isEligible=donorData.isEligible !==false &&
                                                            (!donorData.lastDonated || new Date(donorData.lastDonated) <
                                                            new Date(Date.now() - 56 * 24 * 60 * 60 * 1000)); %>

                                                            <div class="row g-24">
                                                                <div class="col-12 col-xl-4">
                                                                    <div
                                                                        class="card border-0 shadow-sm overflow-hidden">
                                                                        <div class="position-relative"
                                                                            style="min-height: 320px; background: linear-gradient(135deg, #dbeafe 0%, #eff6ff 100%);">
                                                                            <img src="<%= donorImage %>"
                                                                                alt="<%= donorName %>"
                                                                                class="w-100 h-100"
                                                                                style="object-fit: cover; min-height: 320px;">
                                                                        </div>

                                                                        <div class="card-body p-24 text-center">
                                                                            <span
                                                                                class="badge bg-primary mb-8 text-white">ID:
                                                                                <%= donationId %></span>
                                                                            <h3 class="mb-4">
                                                                                <%= donorName %>
                                                                            </h3>
                                                                            <p class="mb-12 text-muted">
                                                                                <%= donorData.occupation
                                                                                    || 'Donor profile overview' %>
                                                                            </p>

                                                                            <div
                                                                                class="d-flex flex-wrap justify-content-center gap-8 mb-16">
                                                                                <span class="badge bg-danger">
                                                                                    <%= donorData.bloodGroup
                                                                                        || 'Unknown' %>
                                                                                </span>
                                                                                <% if (isEligible) { %>
                                                                                    <span
                                                                                        class="badge bg-success">Eligible
                                                                                        to Donate</span>
                                                                                    <% } else { %>
                                                                                        <span
                                                                                            class="badge bg-warning text-dark">Not
                                                                                            Eligible Yet</span>
                                                                                        <% } %>
                                                                            </div>

                                                                            <div class="d-grid gap-2">
                                                                                <a href="/donors/<%= donorId %>/edit"
                                                                                    class="btn btn-primary">Edit
                                                                                    Donor</a>

                                                                            </div>
                                                                        </div>
                                                                    </div>
                                                                </div>

                                                                <div class="col-12 col-xl-8">
                                                                    <div class="row g-24">
                                                                        <div class="col-12 col-md-6">
                                                                            <div class="card border-0 shadow-sm h-100">
                                                                                <div class="card-body p-24">
                                                                                    <h4 class="mb-16">Personal
                                                                                        Information
                                                                                    </h4>
                                                                                    <div
                                                                                        class="d-flex justify-content-between mb-12">
                                                                                        <span class="text-muted">Full
                                                                                            Name</span><strong>
                                                                                            <%= donorName %>
                                                                                        </strong>
                                                                                    </div>
                                                                                    <div
                                                                                        class="d-flex justify-content-between mb-12">
                                                                                        <span
                                                                                            class="text-muted">Gender</span><strong>
                                                                                            <%= donorData.gender
                                                                                                || 'Not provided' %>
                                                                                        </strong>
                                                                                    </div>
                                                                                    <div
                                                                                        class="d-flex justify-content-between mb-12">
                                                                                        <span class="text-muted">Date of
                                                                                            Birth</span><strong>
                                                                                            <%= dateOfBirth %>
                                                                                        </strong>
                                                                                    </div>
                                                                                    <div
                                                                                        class="d-flex justify-content-between mb-12">
                                                                                        <span
                                                                                            class="text-muted">Phone</span><strong>
                                                                                            <%= donorData.phoneNumber
                                                                                                || 'Not provided' %>
                                                                                        </strong>
                                                                                    </div>
                                                                                    <div
                                                                                        class="d-flex justify-content-between">
                                                                                        <span
                                                                                            class="text-muted">Email</span><strong>
                                                                                            <%= donorData.email
                                                                                                || 'Not provided' %>
                                                                                        </strong>
                                                                                    </div>
                                                                                </div>
                                                                            </div>
                                                                        </div>

                                                                        <div class="col-12 col-md-6">
                                                                            <div class="card border-0 shadow-sm h-100">
                                                                                <div class="card-body p-24">
                                                                                    <h4 class="mb-16">Donation Snapshot
                                                                                    </h4>
                                                                                    <div
                                                                                        class="d-flex justify-content-between mb-12">
                                                                                        <span
                                                                                            class="text-muted">Donation
                                                                                            Count</span><strong>
                                                                                            <%= donorData.donationCount
                                                                                                || 0 %>
                                                                                        </strong>
                                                                                    </div>
                                                                                    <div
                                                                                        class="d-flex justify-content-between mb-12">
                                                                                        <span class="text-muted">Last
                                                                                            Donated</span><strong>
                                                                                            <%= lastDonated %>
                                                                                        </strong>
                                                                                    </div>
                                                                                    <div
                                                                                        class="d-flex justify-content-between mb-12">
                                                                                        <span class="text-muted">Blood
                                                                                            Group</span><strong>
                                                                                            <%= donorData.bloodGroup
                                                                                                || 'Unknown' %>
                                                                                        </strong>
                                                                                    </div>
                                                                                    <div
                                                                                        class="d-flex justify-content-between">
                                                                                        <span
                                                                                            class="text-muted">Status</span><strong>
                                                                                            <%= isEligible
                                                                                                ? 'Eligible to Donate'
                                                                                                : 'Not Eligible Yet' %>
                                                                                        </strong>
                                                                                    </div>
                                                                                </div>
                                                                            </div>
                                                                        </div>

                                                                        <div class="col-12">
                                                                            <div class="card border-0 shadow-sm">
                                                                                <div class="card-body p-24">
                                                                                    <h4 class="mb-16">Contact & Address
                                                                                    </h4>
                                                                                    <div class="row g-16">
                                                                                        <div class="col-12 col-md-6">
                                                                                            <div
                                                                                                class="p-16 rounded bg-light h-100">
                                                                                                <div
                                                                                                    class="text-muted mb-4">
                                                                                                    Address</div>
                                                                                                <div>
                                                                                                    <%= donorData.address
                                                                                                        || 'No address provided'
                                                                                                        %>
                                                                                                </div>
                                                                                            </div>
                                                                                        </div>
                                                                                        <div class="col-12 col-md-6">
                                                                                            <div
                                                                                                class="p-16 rounded bg-light h-100">
                                                                                                <div
                                                                                                    class="text-muted mb-4">
                                                                                                    Occupation</div>
                                                                                                <div>
                                                                                                    <%= donorData.occupation
                                                                                                        || 'Not provided'
                                                                                                        %>
                                                                                                </div>
                                                                                            </div>
                                                                                        </div>
                                                                                    </div>
                                                                                </div>
                                                                            </div>
                                                                        </div>

                                                                        <div class="col-12">
                                                                            <div class="card border-0 shadow-sm">
                                                                                <div class="card-body p-24">
                                                                                    <h4 class="mb-16">Next of Kin</h4>
                                                                                    <div class="row g-16">
                                                                                        <div class="col-12 col-md-4">
                                                                                            <div
                                                                                                class="p-16 rounded bg-light h-100">
                                                                                                <div
                                                                                                    class="text-muted mb-4">
                                                                                                    Name</div>
                                                                                                <div>
                                                                                                    <%= donorData.nextOfKinName
                                                                                                        || 'Not provided'
                                                                                                        %>
                                                                                                </div>
                                                                                            </div>
                                                                                        </div>
                                                                                        <div class="col-12 col-md-4">
                                                                                            <div
                                                                                                class="p-16 rounded bg-light h-100">
                                                                                                <div
                                                                                                    class="text-muted mb-4">
                                                                                                    Relationship</div>
                                                                                                <div>
                                                                                                    <%= donorData.nextOfKinRelationship
                                                                                                        || 'Not provided'
                                                                                                        %>
                                                                                                </div>
                                                                                            </div>
                                                                                        </div>
                                                                                        <div class="col-12 col-md-4">
                                                                                            <div
                                                                                                class="p-16 rounded bg-light h-100">
                                                                                                <div
                                                                                                    class="text-muted mb-4">
                                                                                                    Phone Number</div>
                                                                                                <div>
                                                                                                    <%= donorData.nextOfKinPhoneNumber
                                                                                                        || 'Not provided'
                                                                                                        %>
                                                                                                </div>
                                                                                            </div>
                                                                                        </div>
                                                                                    </div>
                                                                                </div>
                                                                            </div>
                                                                        </div>
                                                                        <div class="col-12">
                                                                            <div class="card border-0 shadow-sm">
                                                                                <div class="card-body p-24">
                                                                                    <h4 class="mb-16">Recent Donations
                                                                                    </h4>
                                                                                    <% if (typeof donations
                                                                                        !=='undefined' && donations &&
                                                                                        donations.length> 0) { %>
                                                                                        <div class="table-responsive">
                                                                                            <table
                                                                                                class="table table-striped table-hover">
                                                                                                <thead>
                                                                                                    <tr>
                                                                                                        <th>Donation
                                                                                                            Code</th>
                                                                                                        <th>Status</th>
                                                                                                        <th>Date</th>
                                                                                                        <th>Units</th>
                                                                                                        <th>Actions</th>
                                                                                                    </tr>
                                                                                                </thead>
                                                                                                <tbody>
                                                                                                    <% donations.forEach(function(d)
                                                                                                        { %>
                                                                                                        <tr>
                                                                                                            <td>
                                                                                                                <%= d.donationCode
                                                                                                                    ||
                                                                                                                    (d._id
                                                                                                                    &&
                                                                                                                    d._id.toString())
                                                                                                                    %>
                                                                                                            </td>
                                                                                                            <td>
                                                                                                                <%= d.status
                                                                                                                    || 'N/A'
                                                                                                                    %>
                                                                                                            </td>
                                                                                                            <td>
                                                                                                                <%= d.donationDate
                                                                                                                    ?
                                                                                                                    (new
                                                                                                                    Date(d.donationDate)).toLocaleDateString()
                                                                                                                    : '—'
                                                                                                                    %>
                                                                                                            </td>
                                                                                                            <td>
                                                                                                                <%= d.bloodUnits
                                                                                                                    ?
                                                                                                                    d.bloodUnits.length
                                                                                                                    :
                                                                                                                    (d.unitsCount
                                                                                                                    ||
                                                                                                                    0)
                                                                                                                    %>
                                                                                                            </td>
                                                                                                            <td>
                                                                                                                <a href="/donations/<%= d._id %>"
                                                                                                                    class="btn btn-sm btn-outline-primary">View</a>
                                                                                                            </td>
                                                                                                        </tr>
                                                                                                        <% }); %>
                                                                                                </tbody>
                                                                                            </table>
                                                                                        </div>
                                                                                        <% } else { %>
                                                                                            <div class="text-muted">No
                                                                                                donations found for this
                                                                                                donor.</div>
                                                                                            <% } %>
                                                                                </div>
                                                                            </div>
                                                                        </div>
                                                                    </div>
                                                                </div>
                                                            </div>
                        </div>
                </div>
        </main>

    </body>
    <%- include('../partials/bottom'); %>

</html>