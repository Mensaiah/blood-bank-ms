<div class="transition-content" id="transitionContent">
    <% if (allowedTransitions && allowedTransitions.length> 0) { %>
        <form id="transitionForm" hx-patch="/api/donations/units/<%= unitId %>/status" hx-target="#transitionModalBody"
            hx-swap="outerHTML">
            <div class="mb-24">
                <div class="p-12 rounded bg-light mb-16">
                    <div class="text-muted small mb-2">Current Status</div>
                    <div class="fw-semibold">
                        <span class="badge bg-secondary text-uppercase">
                            <%= currentStatus %>
                        </span>
                    </div>
                </div>

                <label for="statusSelect" class="form-label">Next Status</label>
                <select id="statusSelect" name="status" class="form-select" required>
                    <option value="">Select a status...</option>
                    <% allowedTransitions.forEach(function(status) { %>
                        <option value="<%= status %>">
                            <%= status %>
                        </option>
                        <% }); %>
                </select>
            </div>

            <div class="d-flex gap-12">
                <button type="submit" class="btn btn-primary">Transition</button>
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
            </div>
        </form>

        <script>
            document.getElementById('transitionForm')?.addEventListener('htmx:afterRequest', function (evt) {
                if (evt.detail && evt.detail.xhr && evt.detail.xhr.status === 200) {
                    const modalElement = document.getElementById('transitionModal');
                    const modal = bootstrap.Modal.getInstance(modalElement) || new bootstrap.Modal(modalElement);
                    modal.hide();
                    setTimeout(function () {
                        window.location.reload();
                    }, 250);
                }
            });
        </script>
        <% } else { %>
            <div class="alert alert-info" role="alert">
                No allowed transitions available for this blood unit status with your user role.
            </div>
            <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Close</button>
            <% } %>
</div>