<style>
    .water-tank {
        width: 12em;
        height: 18em;
        border: 0.2em solid #8B0000;
        border-top: none;
        box-sizing: border-box;
        position: relative;
    }

    .water-tank .liquid {
        width: 100%;
        height: 0;
        bottom: 0;
        position: absolute;
        overflow: hidden;
    }

    .water-tank .liquid svg {
        height: 18em;
        position: absolute;
        bottom: 0;
        left: 0;
        animation: waves 5s infinite linear;
    }

    @keyframes waves {
        0% {
            transform: translateX(-12em);
        }

        100% {
            transform: translateX(0);
        }
    }

    .water-tank .label {
        position: absolute;
        color: white;
        line-height: 1.5em;
        width: 3em;
        font-size: 0.9em;
        text-align: center;
        border-radius: 0.4em;
        margin-bottom: -0.75em;
        background-color: #8B0000;
        right: -3.6em;
    }

    .water-tank .label::before {
        content: "";
        position: absolute;
        background-color: #8B0000;
        width: 0.5em;
        height: 0.5em;
        top: 0.5em;
        left: -0.25em;
        transform: rotate(45deg);
    }

    .water-tank .indicator {
        position: absolute;
        background-color: #8B0000;
        height: 0.2em;
        width: 0.8em;
        margin-bottom: -0.1em;
        right: 0;
    }

    .water-tank .indicator[data-value="25"] {
        bottom: 25%;
    }

    .water-tank .indicator[data-value="50"] {
        bottom: 50%;
    }

    .water-tank .indicator[data-value="75"] {
        bottom: 75%;
    }
</style>

<div class="water-tank" data-percentage="<%= percentage %>">
    <div class="liquid">
        <svg id="bloodTankWater" class="water" viewBox="0 0 200 100">
            <defs>
                <linearGradient id="bloodTankGradient" x1="0%" y1="0%" x2="0%" y2="100%">
                    <stop offset="0" style="stop-color:#FF6B6B" />
                    <stop offset="0.1643" style="stop-color:#FF5555" />
                    <stop offset="0.3574" style="stop-color:#FF3333" />
                    <stop offset="0.5431" style="stop-color:#DD0000" />
                    <stop offset="0.7168" style="stop-color:#BB0000" />
                    <stop offset="0.874" style="stop-color:#990000" />
                    <stop offset="1" style="stop-color:#660000" />
                </linearGradient>
            </defs>
            <path fill="url(#bloodTankGradient)" d="
        M 0,0 v 100 h 200 v -100 
        c -10,0 -15,5 -25,5 c -10,0 -15,-5 -25,-5
        c -10,0 -15,5 -25,5 c -10,0 -15,-5 -25,-5
        c -10,0 -15,5 -25,5 c -10,0 -15,-5 -25,-5
        c -10,0 -15,5 -25,5 c -10,0 -15,-5 -25,-5
      " />
        </svg>
    </div>

    <div class="indicator" data-value="75"></div>
    <div class="indicator" data-value="50"></div>
    <div class="indicator" data-value="25"></div>

    <div id="bloodTankLabel" class="label">
        <%= Math.round(percentage) %>%
    </div>
</div>